{
  "name": "@connectiva-co/dian-sdk",
  "version": "1.0.0",
  "description": "SDK oficial y fuertemente tipificado en TypeScript para los Web Services WCF de la DIAN (Facturación, Nómina, Eventos y Documentos Electrónicos)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "dian",
    "dian-colombia",
    "facturacion-electronica",
    "wcf",
    "soap12",
    "ws-security",
    "xmldsig",
    "cufe",
    "cude",
    "typescript"
  ],
  "author": "Connectiva",
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.1",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-forge": "^1.3.11",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
